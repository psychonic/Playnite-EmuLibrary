<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- Must match the InternalsVisibleTo in EmuLibrary so tests can see internal types. -->
    <AssemblyName>EmuLibrary.Tests</AssemblyName>
    <RootNamespace>EmuLibrary.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Provides SevenZip LZMA Encoder to build lzma-compressed CHD hunks that cross-check the decoder. -->
    <PackageReference Include="LZMA-SDK" Version="22.1.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EmuLibrary\EmuLibrary.csproj" />
  </ItemGroup>

</Project>
